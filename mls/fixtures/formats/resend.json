  "acceptCases": [
    {
      "name": "the author answers the device that asked, into an empty sealed seat",
      "call": "acceptResend",
      "sender": {
        "actor": "actor-ada"
      },
      "group": "g1",
      "row": {
        "group": "g1",
        "author": "actor-ada",
        "sealed": true
      },
      "forDevice": "dev-bo",
      "thisDevice": "dev-bo",
      "asked": true,
      "held": null,
      "commitment": "match",
      "expect": "accept"
    },
    {
      "name": "an answer for another device is left alone",
      "call": "acceptResend",
      "sender": {
        "actor": "actor-ada"
      },
      "group": "g1",
