      "reaction": {
        "messageId": "11111111-1111-1111-1111-111111111111",
        "emoji": "",
        "remove": true
      },
      "keys": [
        "m",
        "peachy",
        "v",
        "x"
      ],
      "expect": {
        "messageId": "11111111-1111-1111-1111-111111111111",
        "emoji": "",
        "remove": true
      }
    },
