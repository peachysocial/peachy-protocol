      "lane": [
        {
          "sender": "bob",
          "wire": "{\"peachy\":\"receipt\",\"v\":1,\"k\":\"delivered\",\"m\":\"m1\"}"
        },
        {
          "sender": "bob",
          "wire": "{\"peachy\":\"receipt\",\"v\":1,\"k\":\"read\",\"m\":\"m3\"}"
