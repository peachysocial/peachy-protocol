      "call": "fold",
      "messages": [
        "m1",
        "m2",
        "m3"
      ],
      "lane": [
        {
          "sender": "bob",
          "wire": "{\"peachy\":\"receipt\",\"v\":1,\"k\":\"read\",\"m\":\"m3\"}"
